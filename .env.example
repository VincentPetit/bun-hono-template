# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000

# ── Database (SQLite) ─────────────────────────────────────────────────────────
DATABASE_PATH=./data/app.db

# ── Observability ─────────────────────────────────────────────────────────────
# Leave unset to disable OpenTelemetry (zero overhead).
# SIGNOZ_ENDPOINT=http://your-signoz-host:4318
# APPLICATION_NAME=my-service
# ENVIRONMENT=production

# ── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV=development

# Set automatically by CI to github.sha for deployment verification.
# APP_VERSION=dev
